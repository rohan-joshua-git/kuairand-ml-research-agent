# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.key
*.pem

# Logs. The run trajectory, intervention count and resource usage are GRADED
# EVIDENCE (the organizer asks for the full trajectory with the best run
# marked), so those are tracked deliberately. The bulky, regenerable parts —
# raw stdout, checkpoints, scratch CSVs — stay out.
logs/*
!logs/.gitkeep
!logs/iterations.jsonl
!logs/iterations_pre_*.jsonl
!logs/interventions.jsonl
!logs/interventions_pre_*.jsonl
!logs/restarts.jsonl
!logs/resource_usage.json
!logs/pitfalls.json

# Final submission artifacts ARE COMMITTED. They are deliverable #6 — the
# graded model output in the Starter Kit schema — so a reviewer must be able
# to obtain them from the repository. Their SHA-256 hashes are recorded in
# submissions/FROZEN_CONFIG.json and verified by a clean-checkout rebuild.
# Only superseded/scratch copies under a subdirectory stay out.
submissions/*/*.csv
submissions/_prev_*.csv

# Raw/processed data (downloadable via pipeline/data/download.py or starter_kit/README.md)
data/raw/*.csv
data/processed/
starter_kit/KuaiRand-Pure/
starter_kit/*.tar.gz

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated code-graph output (graphify) — regenerable via `graphify update .`
graphify-out/
