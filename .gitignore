# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.key
*.pem

# Logs. The run trajectory, intervention count and resource usage are GRADED
# EVIDENCE (the organizer asks for the full trajectory with the best run
# marked), so those are tracked deliberately. The bulky, regenerable parts —
# raw stdout, checkpoints, scratch CSVs — stay out.
logs/*
!logs/.gitkeep
!logs/iterations.jsonl
!logs/iterations_pre_*.jsonl
!logs/interventions.jsonl
!logs/interventions_pre_*.jsonl
!logs/restarts.jsonl
!logs/resource_usage.json
!logs/pitfalls.json

# Final submission artifacts (regenerable via `python -m pipeline.make_submission`)
submissions/*.csv

# Raw/processed data (downloadable via pipeline/data/download.py or starter_kit/README.md)
data/raw/*.csv
data/processed/
starter_kit/KuaiRand-Pure/
starter_kit/*.tar.gz

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated code-graph output (graphify) — regenerable via `graphify update .`
graphify-out/

# Superseded submission artifacts. `submissions/*.csv` above only matches direct
# children, so archived copies under submissions/<subdir>/ slipped through. The
# CSVs are regenerable (`python -m pipeline.make_submission --ensemble-seeds N`)
# and their SHA-256 hashes are recorded in submissions/FROZEN_CONFIG.json, so
# provenance is tracked without ~7MB of prediction rows.
submissions/**/*.csv
